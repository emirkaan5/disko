# Copy to .env (git ignores it) and fill in what Beatport issued for disko.
# Register http://127.0.0.1:8765/callback as the app's redirect URI with Beatport.
# The values here win over anything stored with `python -m live.sources.beatport set-client`.
# Sign-in tokens never go here: they stay in the Keychain.
DISKO_BEATPORT_CLIENT_ID=
# Only if Beatport gave you one. Keep the file private: chmod 600 .env
DISKO_BEATPORT_CLIENT_SECRET=

# Only to try the system with the v4 docs page's own client ID before a real one arrives: disko
# refuses a borrowed client ID (the docs page's) unless this is set. A borrowed client registers no
# loopback redirect, so `login --no-browser` uses the docs client's own
# https://api.beatport.com/v4/auth/o/post-message/ redirect and asks you to paste the code back.
# DISKO_BEATPORT_ALLOW_BORROWED_CLIENT=1

# Playback. disko browses and reads metadata by default and never touches a stream. Set this to 1
# only if the signed-in account holds an active Beatport Streaming plan and its terms let disko read,
# decode and analyze that stream on this Mac: it then grants DECODE, ANALYZE and MIX, and a track's
# audio comes from GET /catalog/tracks/{id}/stream/ (undocumented, partner-facing) and is decoded
# through ffmpeg in memory. No audio is written to disk.
# DISKO_BEATPORT_STREAMING=1

# Optional: a different registered redirect URI, or API root (e.g. tests/fake_beatport.py)
# DISKO_BEATPORT_REDIRECT=http://127.0.0.1:8765/callback
# DISKO_BEATPORT_API=https://api.beatport.com/v4

# Spotify (browsing and metadata only: python -m live.sources.spotify). Create an app at
# https://developer.spotify.com/dashboard, add http://127.0.0.1:8766/callback as its redirect URI,
# and put its client ID here. PKCE: no client secret is needed or kept.
DISKO_SPOTIFY_CLIENT_ID=
# DISKO_SPOTIFY_REDIRECT=http://127.0.0.1:8766/callback
