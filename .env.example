# Copy to .env (git ignores it) and fill in what Beatport issued for disko.
# Register http://127.0.0.1:8765/callback as the app's redirect URI with Beatport.
# The values here win over anything stored with `python -m live.sources.beatport set-client`.
# Sign-in tokens never go here: they stay in the Keychain.
DISKO_BEATPORT_CLIENT_ID=
# Only if Beatport gave you one. Keep the file private: chmod 600 .env
DISKO_BEATPORT_CLIENT_SECRET=

# Optional: a different registered redirect URI, or API root (e.g. tests/fake_beatport.py)
# DISKO_BEATPORT_REDIRECT=http://127.0.0.1:8765/callback
# DISKO_BEATPORT_API=https://api.beatport.com/v4
